{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "liufang.skill.schema.json",
  "title": "Liufang Skill Package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "display",
    "classification",
    "cast",
    "behavior",
    "hit",
    "scaling",
    "presentation",
    "preview"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^active_[a-z0-9_]+$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "product_status": { "enum": ["product", "reference_only"] },
    "source_values": {
      "type": "object",
      "additionalProperties": true,
      "required": ["source", "tlidb_id", "display_level", "raw_lines"],
      "properties": {
        "source": { "const": "tlidb" },
        "tlidb_id": { "type": "string" },
        "display_level": { "type": "integer", "minimum": 1 },
        "raw_lines": { "type": "array", "items": { "type": "string" } },
        "parsed_values": { "type": "object" },
        "anchors": { "type": "object" }
      }
    },
    "level_table": {
      "type": "object",
      "additionalProperties": true,
      "required": ["levels"],
      "properties": {
        "levels": {
          "type": "object",
          "minProperties": 40,
          "maxProperties": 40,
          "additionalProperties": { "type": "object" }
        }
      }
    },
    "auto_release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy"],
      "properties": {
        "policy": { "enum": ["nearest_enemy", "target_cluster", "self_center", "duration_window", "periodic", "defensive_threshold"] },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name_key", "description_key"],
      "properties": {
        "name_key": { "$ref": "#/$defs/localization_key" },
        "description_key": { "$ref": "#/$defs/localization_key" }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tags", "damage_type", "damage_form"],
      "properties": {
        "tags": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "damage_type": { "enum": ["physical", "fire", "cold", "lightning", "chaos"] },
        "damage_form": { "enum": ["attack", "spell", "secondary", "damage_over_time"] }
      }
    },
    "cast": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "target_selector", "search_range", "cooldown_ms", "release_interval_ms", "base_cooldown_ms", "trigger_interval_ms", "mana_cost", "windup_ms", "recovery_ms"],
      "properties": {
        "mode": { "enum": ["instant", "attack", "spell"] },
        "target_selector": { "enum": ["nearest_enemy", "target_enemy", "self", "ground"] },
        "search_range": { "type": "number", "minimum": 0 },
        "cooldown_ms": { "type": "integer", "minimum": 0 },
        "release_interval_ms": { "type": "integer", "minimum": 0 },
        "base_cooldown_ms": { "type": "integer", "minimum": 0 },
        "trigger_interval_ms": { "type": "integer", "minimum": 0 },
        "mana_cost": { "type": "integer", "minimum": 0 },
        "windup_ms": { "type": "integer", "minimum": 0 },
        "recovery_ms": { "type": "integer", "minimum": 0 }
      }
    },
    "behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": ["template", "params"],
      "properties": {
        "template": {
          "enum": [
            "projectile",
            "chain",
            "player_nova",
            "melee_arc",
            "damage_zone",
            "orbit_emitter",
            "line_pierce",
            "orbit",
            "delayed_area"
          ]
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "projectile_speed": { "type": "number", "minimum": 1 },
            "projectile_count": { "type": "integer", "minimum": 1 },
            "burst_interval_ms": { "type": "integer", "minimum": 0 },
            "spread_angle_deg": { "type": "number", "minimum": 0, "maximum": 180 },
            "angle_step": { "type": "number", "minimum": 0, "maximum": 90 },
            "projectile_width": { "type": "number", "minimum": 1 },
            "projectile_height": { "type": "number", "minimum": 1 },
            "max_distance": { "type": "number", "minimum": 1 },
            "hit_policy": { "enum": ["first_hit", "pierce"] },
            "pierce_count": { "type": "integer", "minimum": 0 },
            "collision_radius": { "type": "number", "minimum": 0 },
            "spawn_offset": {
              "type": "object",
              "additionalProperties": false,
              "required": ["x", "y"],
              "properties": {
                "x": { "type": "number" },
                "y": { "type": "number" }
              }
            },
            "projectile_radius": { "type": "number", "minimum": 0 },
            "impact_radius": { "type": "number", "minimum": 0 },
            "max_targets": { "type": "integer", "minimum": 1 },
            "min_duration_ms": { "type": "integer", "minimum": 0 },
            "max_duration_ms": { "type": "integer", "minimum": 1 },
            "duration_ms": { "type": "integer", "minimum": 1 },
            "tick_interval_ms": { "type": "integer", "minimum": 1 },
            "sustained_ticks": { "type": "boolean" },
            "trajectory": { "enum": ["linear", "ballistic"] },
            "travel_time_ms": { "type": "integer", "minimum": 1 },
            "arc_height": { "type": "number", "minimum": 0 },
            "target_policy": { "enum": ["nearest_enemy", "locked_target", "target_position", "nearest_not_hit", "random_enemy"] },
            "projectile_visual_mode": { "enum": ["standard", "falling_arrow"] },
            "projectile_speed_damage_conversion_percent": { "type": "number", "minimum": 0 },
            "forced_element_types": {
              "type": "array",
              "items": { "enum": ["fire", "cold", "lightning"] },
              "minItems": 1
            },
            "allow_same_target_projectile_hits": { "type": "boolean" },
            "shotgun_falloff_coeff": { "type": "number", "minimum": 0, "maximum": 1 },
            "split_projectile_count": { "type": "integer", "minimum": 0 },
            "split_projectile_angle_step_deg": { "type": "number", "minimum": 0, "maximum": 90 },
            "split_projectile_damage_multiplier": { "type": "number", "minimum": 0 },
            "split_projectile_pierce_count": { "type": "integer", "minimum": 0 },
            "split_projectile_speed": { "type": "number", "minimum": 1 },
            "split_projectile_max_distance": { "type": "number", "minimum": 1 },
            "split_projectile_width": { "type": "number", "minimum": 1 },
            "split_projectile_height": { "type": "number", "minimum": 1 },
            "split_projectile_collision_radius": { "type": "number", "minimum": 0 },
            "on_kill_explosion_chance_percent": { "type": "number", "minimum": 0, "maximum": 100 },
            "on_kill_explosion_radius": { "type": "number", "minimum": 0 },
            "on_kill_explosion_max_life_percent": { "type": "number", "minimum": 0 },
            "on_kill_explosion_damage_type": { "enum": ["true"] },
            "on_ignited_hit_explosion_radius": { "type": "number", "minimum": 0 },
            "on_ignited_hit_true_damage_percent_of_ignite_dps": { "type": "number", "minimum": 0 },
            "on_ignited_hit_indirect_fire_damage": { "type": "number", "minimum": 0 },
            "on_ignited_hit_cooldown_ms": { "type": "integer", "minimum": 0 },
            "impact_marker_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
            "radius": { "type": "number", "minimum": 1 },
            "expand_duration_ms": { "type": "integer", "minimum": 0 },
            "hit_at_ms": { "type": "integer", "minimum": 0 },
            "center_policy": { "enum": ["player_center"] },
            "damage_falloff_by_distance": { "enum": ["none"] },
            "ring_width": { "type": "number", "minimum": 1 },
            "status_chance_scale": { "type": "number", "minimum": 0, "maximum": 10 },
            "guard_absorb_percent": { "type": "number", "minimum": 0, "maximum": 100 },
            "guard_absorb_amount": { "type": "number", "minimum": 0 },
            "guard_duration_ms": { "type": "integer", "minimum": 1 },
            "guard_exclude_damage_over_time": { "type": "boolean" },
            "on_kill_recast_chance_percent": { "type": "number", "minimum": 0, "maximum": 100 },
            "on_kill_recast_max_per_area": { "type": "integer", "minimum": 1 },
            "suppress_hit_vfx": { "type": "boolean" },
            "arc_angle": { "type": "number", "minimum": 1, "maximum": 180 },
            "arc_radius": { "type": "number", "minimum": 1 },
            "windup_ms": { "type": "integer", "minimum": 0 },
            "shape": { "enum": ["circle", "rectangle"] },
            "origin_policy": { "enum": ["caster", "target_position", "trigger_position"] },
            "facing_policy": { "enum": ["none", "nearest_target", "locked_or_nearest_target"] },
            "hit_shape": { "enum": ["sector", "arc"] },
            "slash_vfx_key": { "$ref": "#/$defs/localization_key" },
            "slash_chance_percent": { "type": "number", "minimum": 0, "maximum": 100 },
            "flame_wave_count": { "type": "integer", "minimum": 1 },
            "flame_wave_count_per_area_step": { "type": "integer", "minimum": 0 },
            "flame_wave_area_step_percent": { "type": "number", "minimum": 1 },
            "flame_wave_distance_bonus_per_area_step_percent": { "type": "number", "minimum": 0 },
            "flame_wave_distance": { "type": "number", "minimum": 1 },
            "flame_wave_spread_angle": { "type": "number", "minimum": 0, "maximum": 180 },
            "flame_wave_arc_angle": { "type": "number", "minimum": 1, "maximum": 180 },
            "allow_same_target_projectile_hits": { "type": "boolean" },
            "zone_vfx_key": { "$ref": "#/$defs/localization_key" },
            "vfx_key": { "$ref": "#/$defs/localization_key" },
            "trigger_marker_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
            "trigger_delay_ms": { "type": "integer", "minimum": 0 },
            "max_hits": { "type": "integer", "minimum": 1 },
            "max_hits_per_target": { "type": "integer", "minimum": 1 },
            "length": { "type": "number", "minimum": 1 },
            "width": { "type": "number", "minimum": 1 },
            "angle_offset_deg": { "type": "number", "minimum": -180, "maximum": 180 }
            ,"chain_count": { "type": "integer", "minimum": 1 },
            "chain_radius": { "type": "number", "minimum": 1 },
            "chain_delay_ms": { "type": "integer", "minimum": 0 },
            "damage_falloff_per_chain": { "type": "number", "minimum": 0, "maximum": 1 },
            "allow_repeat_target": { "type": "boolean" },
            "segment_vfx_key": { "$ref": "#/$defs/localization_key" }
            ,"knockback_policy": { "enum": ["reverse"] },
            "knockback_interval_ms": { "type": "integer", "minimum": 1 },
            "knockback_distance": { "type": "number", "minimum": 1 },
            "aggravation_value": { "type": "number", "minimum": 0 },
            "aggravation_cooldown_ms": { "type": "integer", "minimum": 0 },
            "dot_damage_bonus_per_10_aggravation_percent": { "type": "number", "minimum": 0 }
            ,"orbit_center_policy": { "enum": ["caster"] },
            "duration_ms": { "type": "integer", "minimum": 1 },
            "tick_interval_ms": { "type": "integer", "minimum": 1 },
            "damage_amount": { "type": "number", "minimum": 0 },
            "emit_hit_vfx": { "type": "boolean" },
            "suppress_hit_vfx": { "type": "boolean" },
            "buff_type": { "enum": ["aggravation", "guard", "ignite", "frostbite", "frozen", "shock", "numbed", "trauma", "wilt"] },
            "effect_type": { "enum": ["conversion", "damage_taken_increase"] },
            "polarity": { "enum": ["positive", "negative"] },
            "base_value": { "type": "number", "minimum": 0 },
            "base_damage_per_second": { "type": "number", "minimum": 0 },
            "damage_over_time_more_percent": { "type": "number", "minimum": 0 },
            "dot_damage_bonus_per_ignite_stack_percent": { "type": "number", "minimum": 0 },
            "dot_damage_bonus_max_percent": { "type": "number", "minimum": 0 },
            "effect_per_stack": { "type": "number", "minimum": 0 },
            "stacks": { "type": "integer", "minimum": 1 },
            "max_stacks": { "type": "integer", "minimum": 1 },
            "max_triggers": { "type": "integer", "minimum": 0 },
            "threshold": { "type": "number", "minimum": 0 },
            "conversion_buff_type": { "enum": ["aggravation", "guard", "ignite", "frostbite", "frozen", "shock", "numbed", "trauma", "wilt"] },
            "convert_to_buff_type": { "enum": ["aggravation", "guard", "ignite", "frostbite", "frozen", "shock", "numbed", "trauma", "wilt"] },
            "conversion_consume_source": { "type": "boolean" },
            "source_skill_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
            "channel_max_stacks": { "type": "integer", "minimum": 1 },
            "channel_time_per_stack_ms": { "type": "integer", "minimum": 1 },
            "channel_frequency_cap_stacks": { "type": "integer", "minimum": 1 },
            "cloud_duration_per_stack_ms": { "type": "integer", "minimum": 1 },
            "base_tick_interval_ms": { "type": "integer", "minimum": 1 },
            "channel_tick_during_channel": { "type": "boolean" },
            "slash_chance_percent": { "type": "number", "minimum": 0, "maximum": 100 },
            "slash_damage_scale": { "type": "number", "minimum": 0 },
            "slash_radius": { "type": "number", "minimum": 1 },
            "channel_move_speed_multiplier": { "type": "number", "minimum": 0 },
            "orbit_radius": { "type": "number", "minimum": 1 },
            "orbit_speed_deg_per_sec": { "type": "number" },
            "orb_count": { "type": "integer", "minimum": 1 },
            "start_angle_deg": { "type": "number" },
            "orbit_radius_cycle_enabled": { "type": "boolean" },
            "orbit_radius_cycle_amplitude": { "type": "number", "minimum": 0 },
            "orbit_radius_cycle_period_ms": { "type": "integer", "minimum": 1 },
            "orbit_radius_cycle_phase_deg": { "type": "number" },
            "tick_marker_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
            "spawn_vfx_key": { "$ref": "#/$defs/localization_key" },
            "tick_vfx_key": { "$ref": "#/$defs/localization_key" }
          }
        }
      }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "params"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "type": { "enum": ["projectile", "damage_zone", "buff", "orbit_emitter", "chain", "player_nova", "melee_arc", "line_pierce", "orbit"] },
          "trigger": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "trigger_marker_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
              "trigger_delay_ms": { "type": "integer", "minimum": 0 }
            }
          },
          "params": { "$ref": "#/properties/behavior/properties/params" }
        }
      }
    },
    "hit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_damage", "can_crit", "can_apply_status"],
      "properties": {
        "base_damage": { "type": "number", "minimum": 0 },
        "damage_basis": { "enum": ["flat", "weapon_attack"] },
        "weapon_attack_percent": { "type": "number", "minimum": 0 },
        "damage_components": { "$ref": "#/$defs/damage_components" },
        "damage_conversions": {
          "type": "array",
          "items": { "$ref": "#/$defs/damage_conversion" }
        },
        "ailments": {
          "type": "array",
          "items": { "$ref": "#/$defs/ailment" }
        },
        "secondary_hits": {
          "type": "array",
          "items": { "$ref": "#/$defs/secondary_hit" }
        },
        "can_crit": { "type": "boolean" },
        "can_apply_status": { "type": "boolean" },
        "damage_timing": { "enum": ["on_projectile_hit", "on_area_hit", "on_melee_hit", "on_damage_zone_hit", "on_chain_hit"] },
        "hit_delay_ms": { "type": "integer", "minimum": 0 },
        "hit_radius": { "type": "number", "minimum": 0 },
        "target_policy": { "enum": ["selected_target", "nearest_enemy"] }
      }
    },
    "scaling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["additive_stats", "final_stats", "runtime_params"],
      "properties": {
        "additive_stats": { "type": "array", "items": { "type": "string" } },
        "final_stats": { "type": "array", "items": { "type": "string" } },
        "runtime_params": { "type": "array", "items": { "type": "string" } }
      }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vfx", "sfx", "floating_text", "screen_feedback"],
      "properties": {
        "vfx": { "$ref": "#/$defs/localization_key" },
        "cast_vfx_key": { "$ref": "#/$defs/localization_key" },
        "projectile_vfx_key": { "$ref": "#/$defs/localization_key" },
        "hit_vfx_key": { "$ref": "#/$defs/localization_key" },
        "sfx": { "$ref": "#/$defs/localization_key" },
        "floating_text": { "$ref": "#/$defs/localization_key" },
        "floating_text_style": { "$ref": "#/$defs/localization_key" },
        "screen_feedback": { "$ref": "#/$defs/localization_key" },
        "vfx_scale": { "type": "number", "minimum": 0.1, "maximum": 10 },
        "hit_stop_ms": { "type": "integer", "minimum": 0 },
        "camera_shake": { "type": "number", "minimum": 0 }
      }
    },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["show_fields"],
      "properties": {
        "show_fields": {
          "type": "array",
          "items": {
            "enum": [
              "final_damage",
              "final_cooldown_ms",
              "actual_interval_ms",
              "projectile_count",
              "speed_multiplier",
              "release_interval_ms",
              "base_damage",
              "base_cooldown_ms",
              "base_release_interval_ms",
              "trigger_interval_ms",
              "mana_cost",
              "damage_type",
              "damage_form"
              ,"duration_ms",
              "tick_interval_ms",
              "orbit_radius",
              "orb_count",
              "radius"
            ]
          },
          "minItems": 1
        }
      }
    }
  },
  "$defs": {
    "damage_components": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "physical": { "type": "number", "minimum": 0 },
        "fire": { "type": "number", "minimum": 0 },
        "cold": { "type": "number", "minimum": 0 },
        "lightning": { "type": "number", "minimum": 0 },
        "chaos": { "type": "number", "minimum": 0 }
      }
    },
    "damage_conversion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "percent"],
      "properties": {
        "from": { "enum": ["physical", "fire", "cold", "lightning", "chaos"] },
        "to": { "enum": ["physical", "fire", "cold", "lightning", "chaos"] },
        "percent": { "type": "number", "minimum": 0 }
      }
    },
    "ailment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["aggravation", "guard", "ignite", "frostbite", "frozen", "shock", "numbed", "trauma", "wilt"] },
        "source_damage_type": { "enum": ["physical", "fire", "cold", "lightning", "chaos"] },
        "chance_percent": { "type": "number", "minimum": 0 },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "base_value": { "type": "number", "minimum": 0 },
        "base_damage_per_second": { "type": "number", "minimum": 0 },
        "damage_over_time_more_percent": { "type": "number", "minimum": 0 },
        "dot_damage_bonus_per_ignite_stack_percent": { "type": "number", "minimum": 0 },
        "dot_damage_bonus_max_percent": { "type": "number", "minimum": 0 },
        "stacks": { "type": "integer", "minimum": 1 },
        "max_stacks": { "type": "integer", "minimum": 0 },
        "max_triggers": { "type": "integer", "minimum": 0 },
        "effect_per_stack": { "type": "number", "minimum": 0 },
        "threshold": { "type": "number", "minimum": 0 },
        "conversion_buff_type": { "enum": ["aggravation", "guard", "ignite", "frostbite", "frozen", "shock", "numbed", "trauma", "wilt"] },
        "convert_to_buff_type": { "enum": ["aggravation", "guard", "ignite", "frostbite", "frozen", "shock", "numbed", "trauma", "wilt"] },
        "conversion_consume_source": { "type": "boolean" },
        "source_skill_id": { "type": "string" }
      }
    },
    "secondary_hit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "trigger", "shape", "placement", "base_damage"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "trigger": { "enum": ["on_projectile_hit", "on_hit"] },
        "shape": { "enum": ["circle"] },
        "placement": { "enum": ["behind_target", "impact_position"] },
        "offset_distance": { "type": "number", "minimum": 0 },
        "radius": { "type": "number", "minimum": 0 },
        "base_damage": { "type": "number", "minimum": 0 },
        "damage_basis": { "enum": ["flat", "weapon_attack"] },
        "weapon_attack_percent": { "type": "number", "minimum": 0 },
        "damage_components": { "$ref": "#/$defs/damage_components" },
        "damage_conversions": {
          "type": "array",
          "items": { "$ref": "#/$defs/damage_conversion" }
        },
        "ailments": {
          "type": "array",
          "items": { "$ref": "#/$defs/ailment" }
        },
        "max_targets": { "type": "integer", "minimum": 1 },
        "delay_ms": { "type": "integer", "minimum": 0 },
        "duration_ms": { "type": "integer", "minimum": 1 },
        "tick_interval_ms": { "type": "integer", "minimum": 1 },
        "requires_unsplit_projectile": { "type": "boolean" },
        "vfx_key": { "$ref": "#/$defs/localization_key" },
        "reason_key": { "$ref": "#/$defs/localization_key" }
      }
    },
    "localization_key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]*\\.[a-z0-9_.-]+$"
    }
  }
}
